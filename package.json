{
  "name": "max-audio-player",
  "version": "0.1.2",
  "description": "Vue 3 audio player that auto-recovers corrupted or unplayable audio (WhatsApp, truncated, bad headers) via ffmpeg.wasm",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./recover": "./src/recover.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "0.12.10",
    "@ffmpeg/util": "0.12.1",
    "libcurl.js": "0.7.4"
  },
  "license": "MIT",
  "author": "prolaxu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prolaxu/max-audio-player.git"
  },
  "homepage": "https://github.com/prolaxu/max-audio-player#readme",
  "bugs": {
    "url": "https://github.com/prolaxu/max-audio-player/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "audio",
    "player",
    "ffmpeg",
    "wasm",
    "whatsapp",
    "corrupted-audio"
  ]
}
